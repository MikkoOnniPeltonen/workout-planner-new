PORT=3000
# Your MongoDB connection string. For Atlas, paste the mongodb+srv://… string from
# Connect → Drivers, with your database user's password filled in.
MONGODB_URI=mongodb://localhost:27017/workout-planner
# Required, at least 32 random characters. `pnpm run env:create` fills this in for you, or generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOKEN_SECRET=
# Frontend addresses allowed to call the API: the dev server and `pnpm preview`.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
NODE_ENV=development

# Isolated public demo provisioning; each account expires after 24 hours.
DEMO_ENABLED=true
# Set to the exact number of trusted reverse proxies in production.
TRUST_PROXY=0
